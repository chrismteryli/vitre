scene_a = Sprite(scene_img[0]);
scene_a.SetPosition(ox + 270 * scale, oy + 90 * scale, 1);
scene_b = Sprite(rest_img[0]);
scene_b.SetPosition(ox + 270 * scale, oy + 90 * scale, 2);
scene_b.SetOpacity(0);
bead_s = Sprite(bead_img[0]);
bead_s.SetPosition(ox + 340 * scale, oy + 20 * scale, 3);

# shutdown / reboot: no replay, the rest pose at once
start_ms = 0;
if (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot") start_ms = 2300;

frame = 0;
scene_i = 0;
bead_i = 0;
rest_i = -1;

fun pick (tbl_t, n, cur, now) {
  # the last frame whose time is <= now (frames are in time order; cur is where we were)
  i = cur;
  if (i >= n) i = n - 1;
  if (i < 0 || tbl_t[i] > now) i = 0;
  while (i + 1 < n && tbl_t[i + 1] <= now) i++;
  return i;
}

fun refresh_callback () {
  frame++;
  now = start_ms + frame * 20;
  if (now <= 1970) {
    i = pick(scene_t, scene_n, scene_i, now);
    if (i != scene_i) { scene_i = i; scene_a.SetImage(scene_img[i]); }
    j = pick(bead_t, bead_n, bead_i, now);
    if (j != bead_i) { bead_i = j; bead_s.SetImage(bead_img[j]); }
    bead_s.SetOpacity(1);
    scene_a.SetOpacity(1);
    scene_b.SetOpacity(0);
  } else {
    # rest loop: two sprites crossfade between neighbouring rest frames
    bead_s.SetOpacity(0);
    r = now - 1970;
    if (r < 330) r = 0;
    else r = r - 330;
    period = 2200;
    r = r - Math.Int(r / period) * period;
    step = period / rest_n;
    k = Math.Int(r / step);
    if (k >= rest_n) k = rest_n - 1;
    k2 = k + 1;
    if (k2 >= rest_n) k2 = 0;
    u = (r - k * step) / step;
    if (k != rest_i) { rest_i = k; scene_a.SetImage(rest_img[k]); scene_b.SetImage(rest_img[k2]); }
    scene_a.SetOpacity(1);
    scene_b.SetOpacity(u);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- messages and prompts (plain text, low on the screen) ----
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2, Window.GetY() + Window.GetHeight() * 0.86, 10);
fun message_callback (text) {
  img = Image.Text(text, 1, 1, 1, 0.75);
  message_sprite.SetImage(img);
  message_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - img.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);

fun display_password_callback (prompt, bullets) {
  s = prompt + "  ";
  for (i = 0; i < bullets; i++) s = s + "•";
  message_callback(s);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
fun display_normal_callback () { message_sprite.SetImage(Image.Text("", 1, 1, 1)); }
Plymouth.SetDisplayNormalFunction(display_normal_callback);
