# Maintainer: Vitre <noreply@github.com>
#
# Vitre 0.2.0 for Arch (AUR). Written 2026-10-22; NOT built on Arch yet (see README.md, "Not tested").
#
# Split package, one build: ten packages, the same split as the .debs and the RPMs in ../fedora. The reason: the boot
# splash (vitre-system) changes the machine for every user, so it has to stay its own optional package, and a split lets people install
# only the session, or the extensions, without a second build.
#
#   vitre-desktop         meta package: everything below except vitre-system (optional)
#   vitre-session         the "Vitre" entry at the login screen: shell session mode, Wayland session, gnome-session definition,
#                         dconf defaults that only that session reads, per-user GTK step
#   vitre-shell           the vitre-* GNOME Shell extensions
#   vitre-shell-extras    Vitre Dock and the third-party extensions Vitre uses
#   vitre-theme           Vitre-Glass (GTK 3, GTK 4, window frame, shell) and the GTK stylesheets of the per-user step
#   vitre-icons           the Vitre icon theme
#   vitre-icons-base      VitreBase: MacTahoe-icon-theme without its app icons, built from the pinned ref (nothing is fetched at install)
#   vitre-cursor          the Vitre cursor set
#   vitre-backgrounds     the wallpapers
#   vitre-system          optional: the Vitre boot splash (the login screen theme is not possible here, see README.md)
#
# All files are laid out by vitre-stage.sh, which the Fedora spec runs as well.
#
# GNOME Shell on Arch has an epoch (1:51.1-1), so the version ranges below carry it: a plain 'gnome-shell<52' would never match.

pkgbase=vitre
pkgname=(
  vitre-desktop
  vitre-session
  vitre-shell
  vitre-shell-extras
  vitre-theme
  vitre-icons
  vitre-icons-base
  vitre-cursor
  vitre-backgrounds
  vitre-system
)
pkgver=0.2.0
pkgrel=1
# the base icon theme, at the exact ref that install.sh pins (tag 2026-09-10)
_mactahoe=839848b9a8a38a92a6936e30c4abe35cc6f2546d
arch=(any)
url='https://github.com/chrismteryli/vitre'
license=(GPL-3.0-only)   # each package below sets its own, narrower list
makedepends=(
  python
  glib2   # glib-compile-schemas
)
options=(!strip !debug)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
        "MacTahoe-icon-theme-$_mactahoe.tar.gz::https://github.com/vinceliuice/MacTahoe-icon-theme/archive/$_mactahoe.tar.gz"
        # session files, copied from the .debs' sources by packaging/sync-common.sh (keep them identical across fedora/ and arch/)
        vitre-stage.sh
        make-mode.py
        make-defaults.py
        sanitize-staged.py
        session-extensions.txt
        vitre-mode.json.in
        vitre-session
        vitre.session
        vitre.desktop
        vitre.session.conf
        vitre-user-setup
        vitre-user-setup.service
        dconf-profile-vitre
        vitre-backgrounds.xml
        README.vitre-session
        10-ubuntu-parity
        make-parity.py)
# The first two are the GitHub tag archive and the MacTahoe ref (filled in after v0.2.0 was published; `updpkgsums` from pacman-contrib
# recomputes them). The others are local files; `python3 -I ../check-distro.py --fix-sums` rewrites those after sync-common.sh changed one.
