build() {
  cd "$srcdir"
  VITRE_SRC="$srcdir/$pkgbase-$pkgver" \
  MACTAHOE_SRC="$srcdir/MacTahoe-icon-theme-$_mactahoe" \
  VITRE_COMMON="$srcdir" \
    bash "$srcdir/vitre-stage.sh" "$srcdir/stage"
}

# copy one staged package tree into $pkgdir (the ownership of the build user is not carried over)
_stage() {
  cp -a --no-preserve=ownership "$srcdir/stage/$1/." "$pkgdir/"
}

package_vitre-desktop() {
  pkgdesc='Vitre glass desktop for GNOME (meta package)'
  license=(GPL-3.0-only)
  depends=("vitre-session=$pkgver-$pkgrel"
           "vitre-shell=$pkgver-$pkgrel"
           "vitre-shell-extras=$pkgver-$pkgrel"
           "vitre-theme=$pkgver-$pkgrel"
           "vitre-icons=$pkgver-$pkgrel"
           "vitre-icons-base=$pkgver-$pkgrel"
           "vitre-cursor=$pkgver-$pkgrel"
           "vitre-backgrounds=$pkgver-$pkgrel"
           'gnome-shell>=1:51'
           'gnome-shell<1:52'
           gnome-session
           inter-font
           ttf-jetbrains-mono)
  optdepends=("vitre-system: Vitre boot splash (changes the splash for every user of the machine)")
  _stage vitre-desktop
}

package_vitre-session() {
  pkgdesc='Vitre session for GNOME Shell: a Vitre entry at the login screen'
  license=(GPL-3.0-only)
  depends=("vitre-theme=$pkgver-$pkgrel"
           'gnome-shell>=1:51'
           'gnome-shell<1:52'
           gnome-session
           dconf
           gnome-shell-extensions)   # provides the user-theme extension
  optdepends=("vitre-shell: the Vitre extensions the session names"
              "vitre-shell-extras: Vitre Dock and the third-party extensions"
              "vitre-icons: Vitre icon theme"
              "vitre-cursor: Vitre cursor theme"
              "vitre-backgrounds: Vitre wallpapers"
              "vitre-desktop: all of the above in one go"
              'gnome-shell-extension-appindicator: tray icons in the Vitre session')
  install=vitre-session.install
  backup=(etc/dconf/profile/vitre
          etc/dconf/db/vitre.d/00-vitre
          etc/dconf/db/vitre.d/10-gnome-parity)
  _stage vitre-session
}

package_vitre-shell() {
  pkgdesc='Vitre GNOME Shell extensions'
  license=(GPL-3.0-only)
  depends=('gnome-shell>=1:51'
           'gnome-shell<1:52')
  optdepends=('vitre-shell-extras: Vitre Dock and the third-party extensions')
  _stage vitre-shell
}

package_vitre-shell-extras() {
  pkgdesc='Vitre Dock and third-party GNOME Shell extensions used by Vitre'
  license=(GPL-3.0-only GPL-3.0-or-later GPL-2.0-or-later MIT)
  depends=('gnome-shell>=1:51'
           'gnome-shell<1:52')
  _stage vitre-shell-extras
}

package_vitre-theme() {
  pkgdesc='Vitre glass theme (GTK 3, GTK 4, window frame and shell)'
  license=(MIT GPL-3.0-only GPL-3.0-or-later LGPL-2.1-or-later)
  optdepends=('gnome-shell: the shell part of the theme'
              'inter-font: the font Vitre-Glass is drawn for')
  _stage vitre-theme
}

package_vitre-icons() {
  pkgdesc='Vitre icon theme'
  license=(GPL-3.0-only)
  depends=("vitre-icons-base=$pkgver-$pkgrel"
           hicolor-icon-theme)
  _stage vitre-icons
}

package_vitre-icons-base() {
  pkgdesc='Vitre base icon theme (VitreBase): MacTahoe-icon-theme without its app icons'
  license=(GPL-3.0-only)
  _stage vitre-icons-base
}

package_vitre-cursor() {
  pkgdesc='Vitre cursor theme'
  license=(GPL-3.0-only)
  optdepends=('adwaita-cursors: the cursors Vitre-Cursor does not draw')
  _stage vitre-cursor
}

package_vitre-backgrounds() {
  pkgdesc='Vitre wallpapers'
  license=(GPL-3.0-only)
  _stage vitre-backgrounds
}

package_vitre-system() {
  pkgdesc='Vitre boot splash (optional; changes the splash for every user of the machine)'
  license=(GPL-3.0-only)
  depends=(plymouth)
  install=vitre-system.install
  _stage vitre-system
}
