pkgname = vitre-desktop
	pkgdesc = Vitre glass desktop for GNOME (meta package)
	license = GPL-3.0-only
	depends = vitre-session=0.2.0-1
	depends = vitre-shell=0.2.0-1
	depends = vitre-shell-extras=0.2.0-1
	depends = vitre-theme=0.2.0-1
	depends = vitre-icons=0.2.0-1
	depends = vitre-icons-base=0.2.0-1
	depends = vitre-cursor=0.2.0-1
	depends = vitre-backgrounds=0.2.0-1
	depends = gnome-shell>=1:51
	depends = gnome-shell<1:52
	depends = gnome-session
	depends = inter-font
	depends = ttf-jetbrains-mono
	optdepends = vitre-system: Vitre boot splash (changes the splash for every user of the machine)

pkgname = vitre-session
	pkgdesc = Vitre session for GNOME Shell: a Vitre entry at the login screen
	license = GPL-3.0-only
	depends = vitre-theme=0.2.0-1
	depends = gnome-shell>=1:51
	depends = gnome-shell<1:52
	depends = gnome-session
	depends = dconf
	depends = gnome-shell-extensions
	optdepends = vitre-shell: the Vitre extensions the session names
	optdepends = vitre-shell-extras: Vitre Dock and the third-party extensions
	optdepends = vitre-icons: Vitre icon theme
	optdepends = vitre-cursor: Vitre cursor theme
	optdepends = vitre-backgrounds: Vitre wallpapers
	optdepends = vitre-desktop: all of the above in one go
	optdepends = gnome-shell-extension-appindicator: tray icons in the Vitre session
	install = vitre-session.install
	backup = etc/dconf/profile/vitre
	backup = etc/dconf/db/vitre.d/00-vitre
	backup = etc/dconf/db/vitre.d/10-gnome-parity

pkgname = vitre-shell
	pkgdesc = Vitre GNOME Shell extensions
	license = GPL-3.0-only
	depends = gnome-shell>=1:51
	depends = gnome-shell<1:52
	optdepends = vitre-shell-extras: Vitre Dock and the third-party extensions

pkgname = vitre-shell-extras
	pkgdesc = Vitre Dock and third-party GNOME Shell extensions used by Vitre
	license = GPL-3.0-only
	license = GPL-3.0-or-later
	license = GPL-2.0-or-later
	license = MIT
	depends = gnome-shell>=1:51
	depends = gnome-shell<1:52

pkgname = vitre-theme
	pkgdesc = Vitre glass theme (GTK 3, GTK 4, window frame and shell)
	license = MIT
	license = GPL-3.0-only
	license = GPL-3.0-or-later
	license = LGPL-2.1-or-later
	optdepends = gnome-shell: the shell part of the theme
	optdepends = inter-font: the font Vitre-Glass is drawn for

pkgname = vitre-icons
	pkgdesc = Vitre icon theme
	license = GPL-3.0-only
	depends = vitre-icons-base=0.2.0-1
	depends = hicolor-icon-theme

pkgname = vitre-icons-base
	pkgdesc = Vitre base icon theme (VitreBase): MacTahoe-icon-theme without its app icons
	license = GPL-3.0-only

pkgname = vitre-cursor
	pkgdesc = Vitre cursor theme
	license = GPL-3.0-only
	optdepends = adwaita-cursors: the cursors Vitre-Cursor does not draw

pkgname = vitre-backgrounds
	pkgdesc = Vitre wallpapers
	license = GPL-3.0-only

pkgname = vitre-system
	pkgdesc = Vitre boot splash (optional; changes the splash for every user of the machine)
	license = GPL-3.0-only
	depends = plymouth
	install = vitre-system.install
