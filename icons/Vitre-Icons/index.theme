[Icon Theme]
Name=Vitre-Icons
Comment=Vitre app icons. Original glass artwork that replaces the vendor-look icons and the vendor logo files of MacTahoe-dark. Everything it does not define comes from MacTahoe-dark.
Inherits=MacTahoe-dark
Example=vitre-files
Directories=apps/scalable,places/scalable,places/symbolic

[apps/scalable]
Size=128
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[places/scalable]
Size=128
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[places/symbolic]
Size=16
MinSize=16
MaxSize=512
Context=Places
Type=Scalable
